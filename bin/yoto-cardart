#!/usr/bin/env python3
"""Build 748x1248 card art whose title is still readable once the card is in the player.

The constraint that governs the whole design is not in Yoto's documentation:

    Only roughly the top 21% of the card is visible once it is inserted.

In a 1248 px design that is the top ~262 px. A title centred vertically -- the
obvious layout, and the one every template gives you -- is completely hidden in
normal use. So the title goes in a band at the very top and everything else lives
below it.

A grid of the track icons makes good art for the lower two-thirds: it says what
is on the card at a glance. Each icon sits on a dark rounded tile, because the
icons are drawn for a dark screen and pale subjects -- white birds, cream mice --
disappear against a light card.

    yoto-cardart --title "Winnie-the-Pooh" --subtitle "read by Bernard Cribbins" \
                 --icons "Pooh - icons/" -o card-art.png

    yoto-cardart --check existing-art.png     # show what survives in the slot

The 21% figure is measured from a photo of an inserted card, so treat it as
approximate and leave yourself margin.
"""

import argparse
import os
import sys

try:
    from PIL import Image, ImageDraw, ImageFont
except ImportError:
    sys.exit("needs pillow:  pip3 install pillow")

W, H = 748, 1248
VISIBLE_FRACTION = 0.21           # of card height, once inserted
VISIBLE_PX = int(H * VISIBLE_FRACTION)

FONT_CANDIDATES = [
    "/System/Library/Fonts/Supplemental/Arial Rounded Bold.ttf",
    "/System/Library/Fonts/SFNSRounded.ttf",
    "/System/Library/Fonts/Supplemental/Arial Bold.ttf",
    "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
]


def load_font(size):
    for p in FONT_CANDIDATES:
        if os.path.exists(p):
            try:
                return ImageFont.truetype(p, size)
            except OSError:
                continue
    print("warning: no TrueType font found; falling back to a bitmap font "
          "that will not scale well", file=sys.stderr)
    return ImageFont.load_default()


def fit_text(draw, text, max_width, start, minimum=28):
    """Shrink until it fits the width. Long titles are the usual reason a design
    silently overflows the visible band."""
    size = start
    while size > minimum:
        f = load_font(size)
        if draw.textlength(text, font=f) <= max_width:
            return f
        size -= 4
    return load_font(minimum)


def rounded_tile(size, radius, colour):
    tile = Image.new("RGBA", (size, size), (0, 0, 0, 0))
    ImageDraw.Draw(tile).rounded_rectangle([0, 0, size - 1, size - 1],
                                           radius=radius, fill=colour)
    return tile


def build(title, subtitle, icon_dir, out, band, cream, tile, text, accent, cols):
    card = Image.new("RGBA", (W, H), cream)
    d = ImageDraw.Draw(card)

    # --- title band: everything that must be readable lives above VISIBLE_PX ---
    d.rectangle([0, 0, W, VISIBLE_PX], fill=band)
    d.rectangle([0, VISIBLE_PX, W, VISIBLE_PX + 6], fill=accent)

    tf = fit_text(d, title, W - 96, 84)
    tw = d.textlength(title, font=tf)
    ty = 70 if subtitle else 95
    d.text(((W - tw) / 2, ty), title, font=tf, fill=text)

    if subtitle:
        sf = fit_text(d, subtitle, W - 140, 30)
        sw = d.textlength(subtitle, font=sf)
        d.text(((W - sw) / 2, ty + tf.size + 18), subtitle, font=sf, fill=accent)

    # --- icon grid, below the fold ---
    icons = []
    if icon_dir:
        icons = sorted(f for f in os.listdir(icon_dir)
                       if f.lower().endswith((".png", ".gif")))
    if icons:
        tile_px, gap = 196, 32
        grid_w = cols * tile_px + (cols - 1) * gap
        x0 = (W - grid_w) // 2
        y = VISIBLE_PX + 60
        for i, name in enumerate(icons):
            r, c = divmod(i, cols)
            # centre a short final row
            in_row = min(cols, len(icons) - r * cols)
            row_w = in_row * tile_px + (in_row - 1) * gap
            rx = (W - row_w) // 2 if in_row < cols else x0
            tx = rx + c * (tile_px + gap)
            ty2 = y + r * (tile_px + gap)
            if ty2 + tile_px > H - 80:
                print(f"warning: {len(icons)-i} icon(s) did not fit; "
                      f"use --cols {cols+1}", file=sys.stderr)
                break
            card.alpha_composite(rounded_tile(tile_px, 34, tile), (tx, ty2))
            ic = Image.open(os.path.join(icon_dir, name)).convert("RGBA")
            if ic.size != (16, 16):
                ic = ic.resize((16, 16), Image.NEAREST)
            pad = 26
            card.alpha_composite(ic.resize((tile_px - pad * 2,) * 2, Image.NEAREST),
                                 (tx + pad, ty2 + pad))
        n = len(icons)
        cf = load_font(26)
        label = f"{n} track{'s' if n != 1 else ''}"
        d.text(((W - d.textlength(label, font=cf)) / 2,
                min(H - 70, y + ((n + cols - 1) // cols) * (tile_px + gap) + 14)),
               label, font=cf, fill=(120, 105, 88, 255))

    card.convert("RGB").save(out)
    print(f"wrote {out}  ({W}x{H})")
    print(f"  title band occupies the top {VISIBLE_PX} px -- the part still "
          f"visible with the card in the player")


def check(path):
    im = Image.open(path).convert("RGB")
    if im.size != (W, H):
        print(f"note: {im.size[0]}x{im.size[1]}, not the recommended {W}x{H}")
    vis = int(im.height * VISIBLE_FRACTION)
    out = os.path.splitext(path)[0] + "_in-player.png"
    im.crop((0, 0, im.width, vis)).save(out)
    print(f"{path}")
    print(f"  visible strip is the top {vis} px of {im.height}")
    print(f"  wrote {out} -- if the title is not legible in that image, it is not")
    print(f"  legible on the shelf either")


def main():
    ap = argparse.ArgumentParser(description="Build or check Yoto card art.")
    ap.add_argument("--check", metavar="IMAGE", help="crop an existing design to the visible strip")
    ap.add_argument("--title")
    ap.add_argument("--subtitle")
    ap.add_argument("--icons", help="folder of 16x16 track icons, used in filename order")
    ap.add_argument("-o", "--output", default="card-art-748x1248.png")
    ap.add_argument("--cols", type=int, default=3)
    ap.add_argument("--band", default="#8a5220", help="title band colour")
    ap.add_argument("--cream", default="#faf0d7", help="card background")
    ap.add_argument("--tile", default="#2a2320", help="icon tile colour (keep it dark)")
    ap.add_argument("--text", default="#fdf6e6")
    ap.add_argument("--accent", default="#f0c987")
    a = ap.parse_args()

    if a.check:
        check(a.check)
        return
    if not a.title:
        sys.exit("--title is required (or use --check IMAGE)")

    hexes = lambda s: tuple(int(s.lstrip("#")[i:i+2], 16) for i in (0, 2, 4)) + (255,)
    build(a.title, a.subtitle, a.icons, a.output,
          hexes(a.band), hexes(a.cream), hexes(a.tile),
          hexes(a.text), hexes(a.accent), a.cols)


if __name__ == "__main__":
    main()
